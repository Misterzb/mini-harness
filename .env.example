# OpenAI 兼容网关配置（默认 MaaS 中转，可换任意兼容服务）
# 不配置 key 也能跑：LLM 自动降级为本地 mock，全部演示可用
MINI_HARNESS_API_KEY=网关Key（如 swas.xxx）
MINI_HARNESS_BASE_URL=https://maas-api.simple-server.cn/v1

# 模型：主模型 + 429/5xx 时降级备用。可用模型见网关控制台
# （auto 智能路由 / qwen4-max / qwen3.8-flash / deepseek-v4-pro-0813 / kimi-k2.6 / glm-5.3 ...）
MINI_HARNESS_MODEL=qwen4-max
MINI_HARNESS_MODEL_FALLBACK=kimi-k2.6

# 旧变量名兼容：若仍用 DASHSCOPE_API_KEY 也能识别，优先级低于 MINI_HARNESS_API_KEY
# DASHSCOPE_API_KEY=sk-...
